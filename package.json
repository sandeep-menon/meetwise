{
  "name": "meetwise",
  "private": true,
  "version": "1.0.0",
  "author": "Sandeep Menon",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "msix:stage": "npm run tauri -- build --no-bundle && (if not exist msix mkdir msix) && copy /Y src-tauri\\target\\release\\meetwise.exe msix\\ >nul",
    "msix:run": "npm run msix:stage && powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\msix-run.ps1",
    "msix:pack": "npm run msix:stage && winapp pack .\\msix --no-sign"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "countries-and-timezones": "^3.11.0",
    "country-flag-icons": "^1.6.20",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
